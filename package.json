{
    "name": "@liquid-js/qr-code-styling",
    "version": "5.7.0-2",
    "description": "Generate styled QR codes on web or in Node",
    "type": "module",
    "main": "./lib/qr-code-styling-node.js",
    "browser": "./lib/qr-code-styling.js",
    "types": "./lib/index.d.ts",
    "exports": {
        "./package.json": {
            "default": "./package.json"
        },
        ".": {
            "browser": {
                "types": "./lib/index.d.ts",
                "default": "./lib/qr-code-styling.js"
            },
            "node": {
                "types": "./lib/node.d.ts",
                "default": "./lib/qr-code-styling-node.js"
            },
            "types": "./lib/index.d.ts",
            "default": "./lib/qr-code-styling.js"
        },
        "./kanji": {
            "types": "./lib/kanji.d.ts",
            "default": "./lib/kanji.js"
        },
        "./plugin-utils": {
            "types": "./lib/plugins/utils.d.ts",
            "default": "./lib/plugin-utils.js"
        },
        "./border-plugin": {
            "types": "./lib/plugins/border.d.ts",
            "default": "./lib/border-plugin.js"
        },
        "./event-plugin": {
            "types": "./lib/plugins/event.d.ts",
            "default": "./lib/event-plugin.js"
        },
        "./font-faces-plugin": {
            "types": "./lib/plugins/font-faces.d.ts",
            "default": "./lib/font-faces-plugin.js"
        },
        "./image-mask-plugin": {
            "types": "./lib/plugins/image-mask/index.d.ts",
            "default": "./lib/image-mask-plugin.js"
        },
        "./vcard-plugin": {
            "types": "./lib/plugins/vcard.d.ts",
            "default": "./lib/vcard-plugin.js"
        },
        "./wifi-plugin": {
            "types": "./lib/plugins/wifi.d.ts",
            "default": "./lib/wifi-plugin.js"
        }
    },
    "files": [
        "lib"
    ],
    "peerDependencies": {
        "@liquid-js/qrcode-generator": "^1.1.0",
        "@xmldom/xmldom": "^0.9.0",
        "file-type": "^21.0.0 || ^22.0.0",
        "ical-generator": "^11.0.0",
        "sharp": ">0.32.1 <1.0.0",
        "vcards-js": "^2.10.0",
        "vcf": "^2.1.0"
    },
    "peerDependenciesMeta": {
        "@xmldom/xmldom": {
            "optional": true
        },
        "file-type": {
            "optional": true
        },
        "ical-generator": {
            "optional": true
        },
        "sharp": {
            "optional": true
        },
        "vcards-js": {
            "optional": true
        },
        "vcf": {
            "optional": true
        }
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@liquid-js/qrcode-generator": "^1.1.7",
        "@liquid-js/rollup-plugin-closure-compiler": "^0.28.3",
        "@napi-rs/canvas": "^1.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.2",
        "@rollup/plugin-typescript": "^12.3.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testdeck/mocha": "^0.3.3",
        "@types/chai": "^5.2.3",
        "@types/jsdom": "^30.0.0",
        "@types/jsdom-global": "^3.0.7",
        "@types/mocha": "^10",
        "@types/node": "<25.0.0",
        "@types/sharp": "^0.32.0",
        "@types/source-map-support": "^0.5.10",
        "@types/vcards-js": "^2.10.5",
        "@types/vcf": "^2.0.7",
        "@xmldom/xmldom": "^0.9.12",
        "chai": "^6.3.0",
        "clean-package": "^2.2.0",
        "commit-and-tag-version": "<13.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.4.5",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "file-type": "^22.3.0",
        "google-closure-compiler": "^20261026.0.0",
        "husky": "^9.1.7",
        "ical-generator": "^11.1.3",
        "jsdom": "^31.0.0",
        "jsdom-global": "^3.0.2",
        "mocha": "^12.0.3",
        "npm-check-updates": "^23.1.1",
        "rimraf": "^6.1.4",
        "rollup": "^4.68.2",
        "rollup-plugin-minify-template-literals": "^2.2.0",
        "rollup-plugin-polyfill-node": "^0.13.0",
        "sharp": "^0.35.5",
        "source-map-support": "^0.5.21",
        "ts-ics": "^2.4.8",
        "ts-node-maintained": "^10.9.6",
        "tslib": "^2.9.1",
        "typedoc": "^0.28.20",
        "typescript": "<7.0.0",
        "typescript-eslint": "^8.72.2",
        "vcards-js": "^2.11.1",
        "vcf": "^2.1.2",
        "vite": "^8.3.7"
    },
    "resolutions": {
        "@eslint/core": "^0.17.0"
    },
    "scripts": {
        "build": "rimraf lib && rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript",
        "test": "mocha -p",
        "start": "vite src",
        "lint": "eslint . --fix",
        "prepublishOnly": "npm run build",
        "prepare": "husky",
        "release": "git diff --exit-code && commit-and-tag-version && git push --follow-tags origin",
        "prelease": "git diff --exit-code && commit-and-tag-version -p && git push --follow-tags origin",
        "docs": "typedoc --tsconfig ./tsconfig.lib.json",
        "prepack": "clean-package",
        "postpack": "clean-package restore"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/qr-code-styling.git"
    },
    "keywords": [
        "qr",
        "qrcode",
        "qr-code",
        "js",
        "qrjs",
        "qrstyling",
        "styling",
        "qrbranding",
        "branding",
        "qrimage",
        "image",
        "qrlogo",
        "logo",
        "design",
        "node",
        "nodejs",
        "plugin",
        "plugins",
        "text",
        "border",
        "frame"
    ],
    "author": "HitkoDev <development@hitko.si>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Liquid-JS/qr-code-styling/issues"
    },
    "homepage": "https://qrky.to/",
    "packageManager": "yarn@4.18.1",
    "clean-package": {
        "remove": [
            "packageManager",
            "scripts",
            "devDependencies",
            "clean-package",
            "resolutions"
        ]
    }
}
